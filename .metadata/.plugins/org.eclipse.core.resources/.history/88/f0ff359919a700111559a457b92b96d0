package miniPeople;
public class miniWoman extends miniPerson{
    
    public miniWoman(double [] strength, double [] speed, double [] iq){

        this.strength = strength;
        this.speed = speed;
        this.iq = iq;

        
        this.strength = adjustArray(this.strength, 0.666);
        this.speed = adjustArray(this.speed, 0.8);
        this.iq = adjustArray(this.iq, 1.25);
        
    }
    
    public double[] adjustArray(double[] array, double factor) {
		double[] adjustedArray = new double[array.length];
		for (int i = 0; i < array.length; i++) {
			adjustedArray[i] = array[i] * factor;
		}
		return adjustedArray;
	}

}
