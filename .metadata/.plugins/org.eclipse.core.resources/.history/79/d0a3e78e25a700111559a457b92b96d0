package utilities;
import miniPeople.*;
public class generateMiniPerson {
	
	miniPerson mp;
	
	public generateMiniPerson() {

	}
	
	public miniPerson generate() {
		double [] strength = util.generateDoubleArray(2, 10, 100);
		double [] speed = util.generateDoubleArray(2, 10, 100);
		double [] iq = util.generateDoubleArray(2, 10, 100);

		if ((int)(Math.random() * 2) == 0){
			mp = new miniMan(strength, speed, iq);
		} else {
			mp = new miniWoman(strength, speed, iq);
		}

		return mp;
	}
	
}
