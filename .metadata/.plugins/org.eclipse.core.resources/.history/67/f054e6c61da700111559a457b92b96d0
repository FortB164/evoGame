package populationBoard;

import miniPeople.miniPerson;

public class boardController {
	
	int sizeX;
	int sizeY;
	populationBoard board;
	
	
	boardController(int sizeX, int sizeY, populationBoard board) {

		this.sizeX = sizeX;
		this.sizeY = sizeY;
		this.board = board;
	}
	
	
	public miniPerson getPerson(int x, int y) {
        board.validateCoordinate(x, y);
        board.populationMap.get(new coordinatePair(x, y));
        return board.getPerson(x, y);
    }
	
	
}
